          <h2 id="home-latest-title">מה חדש</h2>
        </div>
        <a class="home-section-heading__link" href="{{ '/updates/' | url }}">לכל העדכונים ←</a>
      </div>
      <div class="home-latest__list">
        {% for item in updates.items %}
          {% if loop.index <= 2 %}
            <article class="home-latest__item">
              <p class="home-latest__meta">{{ item.dateLabel }} · {{ item.category }}</p>
              <h3>{{ item.title }}</h3>
              <p>{{ item.summary }}</p>
            </article>
          {% endif %}
        {% endfor %}
      </div>
    </section>
