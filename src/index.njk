    <section class="home-featured" aria-labelledby="home-featured-title">
      <div class="home-section-heading">
        <div>
          <p class="home-section__eyebrow">מן הספרייה</p>
          <h2 id="home-featured-title">חיבורים לעיון</h2>
          <p>ארבעה חיבורים מארבע מסורות לשון — מן הנוסח ועד המבוא והפרקים.</p>
        </div>
        <a class="home-section-heading__link" href="{{ '/texts/' | url }}">לכל הספרייה ←</a>
      </div>
      <div class="home-work-grid">
        {% for featured in featuredWorks %}
          {% set entry = featured.book | bookCatalogEntry %}
          {% set langEntry = languages[entry.lang] %}
          <article class="home-work-card" data-home-featured="{{ featured.book }}">
            <p class="home-work-card__meta">
              <span>{{ langEntry.label if langEntry else entry.lang }}</span>
              <span aria-hidden="true">·</span>
              <span>{{ figures[entry.figure] or entry.figure }}</span>
            </p>
            <h3><a href="{{ featured.href | url }}">{{ entry.title }}</a></h3>
            <p class="home-work-card__description">{{ entry.description }}</p>
            <p class="home-work-card__note">{{ featured.note }}</p>
            <span class="home-work-card__link">למבוא ולתוכן העניינים</span>
          </article>
        {% endfor %}
      </div>
    </section>

    <section class="home-navigation" aria-labelledby="home-navigation-title">
      <div class="home-section-heading">
        <div>
          <p class="home-section__eyebrow">דרכי העיון</p>
          <h2 id="home-navigation-title">לפתוח את האוצר</h2>
        </div>
      </div>
      <div class="home-navigation__grid">
        <section class="home-navigation__group">
          <h3>לפי חלקי המקרא</h3>
          <div class="home-navigation__links">
            {% for sectionKey in bibleSectionOrder %}
              <a href="{{ ('/texts/#' + sectionKey) | url }}">{{ bibleSections.sections[sectionKey].title }}</a>
            {% endfor %}
            <a href="{{ '/texts/' | url }}" class="home-navigation__all">כל החיבורים ←</a>
          </div>
        </section>
        <section class="home-navigation__group">
          <h3>לפי שפת המקור</h3>
          <div class="home-language-list">
            {% for langSlug, langEntry in languages %}
              <a href="{{ ('/texts/' + langSlug + '/') | url }}">{{ langEntry.label }}</a>
            {% endfor %}
          </div>
        </section>
        <a class="home-navigation__feature" href="{{ '/by-figure/' | url }}">
          <span>ייחוס ומסורת</span>
          <strong>כתבים לפי דמות</strong>
          <small>אברהם, משה, דניאל, עזרא, אליהו ואחרים ←</small>
        </a>
        <a class="home-navigation__feature" href="{{ '/search/' | url }}">
          <span>איתור ועיון</span>
          <strong>חיפוש באוצר</strong>
          <small>חיפוש שמות, ביטויים ומילים בגוף הכתבים והביאורים ←</small>
        </a>
      </div>
    </section>

    <section class="home-latest" aria-labelledby="home-latest-title">
