---
pagination:
  data: bibleSectionOrder
  size: 1
  alias: sectionKey
layout: base.njk
permalink: "/by-figure/{{ sectionKey }}/index.html"
---

{% set section = bibleSections.sections[sectionKey] %}
{% set sectionBooks = section.books or [] %}
{% set sectionFigures = section.figures or [] %}

<div class="text-main category-listing">
  <header class="text-header">
    <p class="text-header__eyebrow">התנ"ך האפוקריפי</p>
    <h1>{{ section.title }}</h1>
    <p>{{ section.subtitle }}</p>
  </header>

  {# Group books by figure within this section #}
  {% for figureKey in sectionFigures %}
    {% set figureName = figures[figureKey] or figureKey %}
    {% set figureHasBooks = false %}
    {# Check if any book in this section belongs to this figure #}
    {% for item in collections.texts %}
      {% if item.data.figure == figureKey and item.data.book and item.data.pageNumber == 0 and not (item.data.tags | hasTag("sub-intro")) %}
        {% set figureHasBooks = true %}
      {% endif %}
    {% endfor %}
    {% if figureHasBooks %}
    <section class="figure-group">
      <h2 class="figure-group__title">{{ figureName }}</h2>
      <div class="book-list">
        {% for item in collections.texts %}
          {% if item.data.figure == figureKey and item.data.book and item.data.pageNumber == 0 and not (item.data.tags | hasTag("sub-intro")) %}
            <article class="book-card{% if item.data.comingSoon %} book-card--coming-soon{% endif %}">
              <h3>
                <a class="book-card__primary-link" href="{{ item.url | url }}">{{ item | displayBookTitle }}</a>
                {% if item.data.rarity == "unpublished" %}<span class="book-card__badge book-card__badge--unpublished" title="פרסום ראשון מתוך כתב־יד — לא הודפס מעולם">פרסום ראשון</span>{% endif %}
                {% if item.data.comingSoon %}<span class="book-card__badge book-card__badge--coming-soon" title="החיבור בהכנה">בקרוב</span>{% endif %}
              </h3>
              <p class="book-card__description">{{ item.data.description or "חיבור המיוחס ל" + figureName }}</p>
              {% if item.data.source %}
                {% set langEntry = languages[item.data.source] %}
                {% set langLabel = (langEntry.label if langEntry else item.data.source) %}
                <p><small>מקור: {{ langLabel }}</small></p>
              {% endif %}
            </article>
          {% endif %}
        {% endfor %}
      </div>
    </section>
    {% endif %}
  {% endfor %}

  {# Also show any books in this section that don't have a figure match (fallback) #}
  {% set hasUnmatched = false %}
  {% for item in collections.texts %}
    {% if item.data.book and item.data.pageNumber == 0 and not (item.data.tags | hasTag("sub-intro")) %}
      {% set itemFigure = item.data.figure or '' %}
      {% set isInSection = false %}
      {% for figureKey in sectionFigures %}
        {% if itemFigure == figureKey %}{% set isInSection = true %}{% endif %}
      {% endfor %}
      {% if not isInSection %}
        {# Check if this book's ID is in the section's book list #}
        {% for bookId in sectionBooks %}
          {% if item.data.book == bookId %}{% set isInSection = true %}{% endif %}
        {% endfor %}
      {% endif %}
    {% endif %}
  {% endfor %}

  <nav class="bible-sections-nav" aria-label="ניווט בין חלקי התנך">
    <a href="{{ '/#bible-sections' | url }}" class="bible-sections-nav__back">← חזרה לתנ"ך האפוקריפי</a>
    <div class="bible-sections-nav__sections">
      {% for otherKey in bibleSectionOrder %}
        {% if otherKey != sectionKey %}
          <a href="{{ ('/by-figure/' + otherKey + '/') | url }}" class="bible-sections-nav__link">{{ bibleSections.sections[otherKey].title }}</a>
        {% endif %}
      {% endfor %}
    </div>
  </nav>
</div>
