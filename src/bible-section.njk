---
pagination:
  data: bibleSectionOrder
  size: 1
  alias: sectionKey
layout: base.njk
permalink: "/by-figure/{{ sectionKey }}/index.html"
eleventyComputed:
  title: "{{ bibleSections.sections[sectionKey].title }}"
---

{% set section = bibleSections.sections[sectionKey] %}
{% set sectionBooks = section.books or [] %}

<div class="text-main library-page">
  <header class="text-header">
    <div class="library-shelf__icon" aria-hidden="true">{% set iconKey = sectionKey %}{% include "section-icon.njk" %}</div>
    <p class="text-header__eyebrow">התנ"ך האפוקריפי</p>
    <h1>{{ section.title }}</h1>
    <p>{{ section.subtitle }}</p>
  </header>

  {# --- חיבורים פעילים — בסדר הקטלוג, בשפת הספרייה --- #}
  <div class="library-shelves">
    <section class="library-shelf">
      <div class="library-shelf__active">
        {% for bookId in sectionBooks %}
          {% for item in collections.texts %}
            {% if item.data.book == bookId and item.data.pageNumber == 0 and not (item.data.tags | hasTag("sub-intro")) and not item.data.comingSoon %}
              <article class="library-book">
                <a href="{{ item.url | url }}" class="library-book__link">{{ item | displayBookTitle }}</a>
                <p class="library-book__desc">{{ item.data.description }}</p>
                <p class="library-book__meta">
                  {% set langEntry = languages[item.data.source] %}
                  {{ langEntry.label if langEntry else item.data.source }} · טקסט מלא
                </p>
              </article>
            {% endif %}
          {% endfor %}
        {% endfor %}
      </div>

      {# --- חיבורים בהכנה --- #}
      {% set comingBooks = [] %}
      {% for bookId in sectionBooks %}
        {% set catEntry = bookId | bookCatalogEntry %}
        {% if catEntry and catEntry.comingSoon %}
          {% set _ = comingBooks.push(catEntry.title) %}
        {% endif %}
      {% endfor %}
      {% if comingBooks.length %}
        <details class="library-shelf__coming">
          <summary>בהכנה · {{ comingBooks.length }} חיבורים</summary>
          <ul class="library-coming-list">
            {% for title in comingBooks %}
              <li>{{ title }}</li>
            {% endfor %}
          </ul>
        </details>
      {% endif %}
    </section>
  </div>

  <nav class="bible-sections-nav" aria-label="ניווט בין חלקי התנך">
    <a href="{{ '/texts/' | url }}" class="bible-sections-nav__back">← אל הספרייה</a>
    <div class="bible-sections-nav__sections">
      {% for otherKey in bibleSectionOrder %}
        {% if otherKey != sectionKey %}
          <a href="{{ ('/texts/#' + otherKey) | url }}" class="bible-sections-nav__link">{{ bibleSections.sections[otherKey].title }}</a>
        {% endif %}
      {% endfor %}
    </div>
  </nav>
</div>
