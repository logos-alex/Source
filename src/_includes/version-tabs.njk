{# Version tabs for multi-version books.
   Shows a tab strip linking to the equivalent page in each version.
   Only rendered when the book has more than one declared version.

   Variables expected:
     - book: the book id (e.g. "apocalypse-abraham")
     - version: the current version key (e.g. "a", "b", "c", "main")
     - source: the source/language key (e.g. "slavic")
     - page: the current Eleventy page object (for URL detection)
#}
{% set catalogEntry = book | bookCatalogEntry %}
{% if catalogEntry and catalogEntry.versions and catalogEntry.versions | length > 1 %}
  {% set versions = catalogEntry.versions %}
  {% set versionKeys = versions | keys | sort %}

  {# Determine the page number from the current URL (e.g. "5" from /page-5/) #}
  {% set currentPageNum = "" %}
  {% if page.url %}
    {% set pageMatch = page.url | regexMatch("/page-(\\d+)/") %}
    {% if pageMatch and pageMatch.length > 1 %}
      {% set currentPageNum = pageMatch[1] %}
    {% endif %}
  {% endif %}

  {# Build base path: /texts/<source>/<book>/ (for main) or /texts/<source>/<book>/<version>/ (for versioned) #}
  {% set basePath = "/texts/" ~ source ~ "/" ~ book ~ "/" %}

  {# Load the alignment map once (used for soft cross-links between versions
     and — when a commentary layer exists — for the commentary tab). #}
  {% set alignmentKey = book ~ "-alignment" %}
  {% set alignmentData = alignmentKey | getGlobalData %}

  {# Collect all existing URLs in the entire book (all versions) so we can verify
     that a target page-N exists before linking to it. We iterate collections.all
     directly (not via the bookPages filter, which is version-scoped). #}
  {% set allBookUrls = [] %}
  {% for item in collections.all %}
    {% if item.data.book == book and not item.data.draft %}
      {% set allBookUrls = allBookUrls | push(item.url) %}
    {% endif %}
  {% endfor %}

  <nav class="version-tabs" role="tablist" aria-label="נוסחים">
    {# Tab for the "main" version (book overview) #}
    {% set mainUrl = basePath %}
    {% set isMainActive = (version == "main" or not version) %}
    <a href="{{ mainUrl | url }}"
       class="version-tabs__tab{% if isMainActive %} is-active{% endif %}"
       role="tab"
       {% if isMainActive %}aria-selected="true" aria-current="page"{% endif %}>
      מבוא כללי
    </a>

    {# Tabs for each declared version #}
    {% for versionKey in versionKeys %}
      {% set versionEntry = versions[versionKey] %}
      {% set isActive = (version == versionKey) %}

      {# Determine the target URL for this version tab.
         Two URL patterns are supported:

         Pattern A (same-source versions, e.g. apocalypse-abraham a/b/c/d):
           /texts/<book_source>/<book>/<version_key>/page-N/

         Pattern B (cross-source versions, e.g. sichat-moshe main/arabic-islamic):
           /texts/<version_source>/<book>/page-N/
           (no version subdirectory; the source directory distinguishes versions)

         The pattern is chosen based on whether the version entry has a `source`
         field that differs from the book's source. #}
      {% set versionSource = versionEntry.source if versionEntry.source else source %}
      {% set versionBasePath = "/texts/" ~ versionSource ~ "/" ~ book ~ "/" %}
      {% set targetUrl = versionBasePath %}
      {% if not versionEntry.source %}
        {# Pattern A: version has no own source → use subdirectory #}
        {% set targetUrl = versionBasePath ~ versionKey ~ "/" %}
      {% endif %}
      {% if currentPageNum %}
        {% if versionKey == version %}
          {# The current version's own tab always links to the current page #}
          {% if versionEntry.source %}
            {% set candidateUrl = versionBasePath ~ "page-" ~ currentPageNum ~ "/" %}
          {% else %}
            {% set candidateUrl = versionBasePath ~ versionKey ~ "/page-" ~ currentPageNum ~ "/" %}
          {% endif %}
          {% if candidateUrl in allBookUrls %}
            {% set targetUrl = candidateUrl %}
          {% endif %}
        {% else %}
        {# Soft mapping: first section whose spans include this page #}
        {% set alignmentKey = book ~ "-alignment" %}
        {% set alignmentData = alignmentKey | getGlobalData %}
        {% set softTarget = 0 %}
        {% if alignmentData and alignmentData.sections %}
          {% set n = currentPageNum | int %}
          {% for sKey, section in alignmentData.sections %}
            {% if not softTarget %}
              {% set inSpans = false %}
              {% if section[version ~ "_spans"] %}
                {% for sp in section[version ~ "_spans"] %}
                  {% if sp.page == n %}{% set inSpans = true %}{% endif %}
                {% endfor %}
              {% endif %}
              {% if section[version] == n or inSpans %}
                {% if section[versionKey] %}
                  {% set softTarget = section[versionKey] %}
                {% endif %}
              {% endif %}
            {% endif %}
          {% endfor %}
        {% endif %}
        {% if softTarget %}
          {% if versionEntry.source %}
            {% set candidateUrl = versionBasePath ~ "page-" ~ softTarget ~ "/" %}
          {% else %}
            {% set candidateUrl = versionBasePath ~ versionKey ~ "/page-" ~ softTarget ~ "/" %}
          {% endif %}
          {% if candidateUrl in allBookUrls %}
            {% set targetUrl = candidateUrl %}
          {% endif %}
        {% else %}
          {% if versionEntry.source %}
            {% set candidateUrl = versionBasePath ~ "page-" ~ currentPageNum ~ "/" %}
          {% else %}
            {% set candidateUrl = versionBasePath ~ versionKey ~ "/page-" ~ currentPageNum ~ "/" %}
          {% endif %}
          {% if candidateUrl in allBookUrls %}
            {% set targetUrl = candidateUrl %}
          {% endif %}
        {% endif %}
        {% endif %}
      {% endif %}

      <a href="{{ targetUrl | url }}"
         class="version-tabs__tab{% if isActive %} is-active{% endif %}"
         role="tab"
         {% if isActive %}aria-selected="true" aria-current="page"{% endif %}
         title="{{ versionEntry.title }}">
        {{ versionEntry.title if versionEntry.title else "נוסח " ~ versionKey }}
      </a>
    {% endfor %}

</nav>
{% endif %}
