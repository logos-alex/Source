{# Version tabs for multi-version books.
   Shows a tab strip linking to the equivalent page in each version.
   Only rendered when the book has more than one declared version.

   Variables expected:
     - book: the book id (e.g. "apocalypse-abraham")
     - version: the current version key (e.g. "a", "b", "c", "main")
     - source: the source/language key (e.g. "slavic")
     - page: the current Eleventy page object (for URL detection)
#}
{% set catalogEntry = book | bookCatalogEntry %}
{% if catalogEntry and catalogEntry.versions and catalogEntry.versions | length > 1 %}
  {% set versions = catalogEntry.versions %}
  {% set versionKeys = versions | keys | sort %}

  {# Determine the page number from the current URL (e.g. "5" from /page-5/) #}
  {% set currentPageNum = "" %}
  {% if page.url %}
    {% set pageMatch = page.url | regexMatch("/page-(\\d+)/") %}
    {% if pageMatch and pageMatch.length > 1 %}
      {% set currentPageNum = pageMatch[1] %}
    {% endif %}
  {% endif %}

  {# Build base path: /texts/<source>/<book>/ (for main) or /texts/<source>/<book>/<version>/ (for versioned) #}
  {% set basePath = "/texts/" ~ source ~ "/" ~ book ~ "/" %}

  {# Collect all existing URLs in the entire book (all versions) so we can verify
     that a target page-N exists before linking to it. We iterate collections.all
     directly (not via the bookPages filter, which is version-scoped). #}
  {% set allBookUrls = [] %}
  {% for item in collections.all %}
    {% if item.data.book == book and not item.data.draft %}
      {% set allBookUrls = allBookUrls | push(item.url) %}
    {% endif %}
  {% endfor %}

  <nav class="version-tabs" role="tablist" aria-label="נוסחים">
    {# Tab for the "main" version (book overview) #}
    {% set mainUrl = basePath %}
    {% set isMainActive = (version == "main" or not version) %}
    <a href="{{ mainUrl | url }}"
       class="version-tabs__tab{% if isMainActive %} is-active{% endif %}"
       role="tab"
       {% if isMainActive %}aria-selected="true" aria-current="page"{% endif %}>
      מבוא כללי
    </a>

    {# Tabs for each declared version #}
    {% for versionKey in versionKeys %}
      {% set versionEntry = versions[versionKey] %}
      {% set isActive = (version == versionKey) %}

      {# Determine the target URL for this version tab.
         If we're on a page-N, try to link to the same page-N in the target version.
         If that page doesn't exist (version has fewer chapters), fall back to the version index. #}
      {% set targetUrl = basePath ~ versionKey ~ "/" %}
      {% if currentPageNum %}
        {% set candidateUrl = basePath ~ versionKey ~ "/page-" ~ currentPageNum ~ "/" %}
        {% if candidateUrl in allBookUrls %}
          {% set targetUrl = candidateUrl %}
        {% endif %}
      {% endif %}

      <a href="{{ targetUrl | url }}"
         class="version-tabs__tab{% if isActive %} is-active{% endif %}"
         role="tab"
         {% if isActive %}aria-selected="true" aria-current="page"{% endif %}
         title="{{ versionEntry.title }}">
        נוסח {{ versionKey }}
      </a>
    {% endfor %}
  </nav>
{% endif %}
