{% extends "base.njk" %}

{% set bodyClass = "text-page" %}

{% block head_extras %}
  {% set pagesInBook = collections.all | bookPages(page.url, book) %}
  {% set currentPageIndex = pagesInBook | findIndexByUrl(page.url) %}
  {% if currentPageIndex > 0 %}
    {% set prevPage = pagesInBook[currentPageIndex - 1] %}
    <link rel="prev" href="{{ prevPage.url | url }}">
  {% endif %}
  {% if currentPageIndex >= 0 and currentPageIndex < pagesInBook.length - 1 %}
    {% set nextPage = pagesInBook[currentPageIndex + 1] %}
    <link rel="next" href="{{ nextPage.url | url }}">
  {% endif %}
{% endblock %}

{% block content %}
  <div class="reading-progress" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" aria-label="התקדמות הקריאה">
    <div class="reading-progress-bar" id="readingProgress"></div>
  </div>

  {% if book | hasMultipleVersions %}
    {% include "version-tabs.njk" %}

    {# --- תצוגה מקבילית בין נוסחים (client-side, טוען את הפרק המקביל בצד) --- #}
    {% if book | hasMultipleVersions and version and version != "main" and pageNumber != 0 %}
      {# טען את טבלת ההתאמה אם קיימת לחיבור זה #}
      {% set alignmentKey = book ~ "-alignment" %}
      {% set alignmentData = alignmentKey | getGlobalData %}
      {% if alignmentData %}
        <script type="application/json" data-alignment="{{ book }}">{{ alignmentData | dump | safe }}</script>
      {% endif %}

      <div class="version-parallel-controls" role="group" aria-label="תצוגה מקבילית של נוסחים">
        <span class="version-parallel-controls__label">תצוגה מקבילית:</span>
        <button class="version-parallel-toggle" type="button" data-version-parallel="off" aria-pressed="false">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/></svg>
          <span>כבויה</span>
        </button>
        {% set catalogEntry = book | bookCatalogEntry %}
        {% if catalogEntry and catalogEntry.versions %}
          {% set versionKeys = catalogEntry.versions | keys | sort %}
          <select class="version-parallel-select" data-version-parallel-select aria-label="נוסח להשוואה">
            {% for vk in versionKeys %}
              {% if vk != version %}
                <option value="{{ vk }}">מול נוסח {{ vk | upper }}'</option>
              {% endif %}
            {% endfor %}
          </select>
        {% endif %}
        <button class="version-diff-toggle" type="button" data-version-diff="off" aria-pressed="false" title="הדגש הבדלים מילוליים בין הנוסחים">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M12 1v6M12 17v6M4.22 4.22l4.24 4.24M15.54 15.54l4.24 4.24M1 12h6M17 12h6M4.22 19.78l4.24-4.24M15.54 8.46l4.24-4.24"/></svg>
          <span>הדגש הבדלים</span>
        </button>
        <span class="version-parallel-controls__section" data-version-parallel-section hidden></span>
      </div>
    {% endif %}
  {% endif %}

  <article class="text-main" data-pagefind-body>
    <header class="text-header">
      {% if book | usesHebrewChapterTitles and pageNumber != 0 %}
        <p class="text-header__eyebrow">פרק {{ pageNumber | toHebrewNumeral }}</p>
        <h1 data-pagefind-meta="title">{{ title }}</h1>
      {% else %}
        <h1 data-pagefind-meta="title">{{ title }}</h1>
      {% endif %}

      {% if source or figure %}
        {% set langEntry = languages[source] %}
        {% set sourceHebrew = (langEntry.label if langEntry else source) %}
        {% set figureHebrew = figures[figure] or figure %}
        <p class="text-meta">
          {% if sourceHebrew %}<span class="text-meta__item"><span class="text-meta__label">מקור:</span> {{ sourceHebrew }}</span>{% endif %}
          {% if sourceHebrew and figureHebrew %}<span class="text-meta__sep" aria-hidden="true">·</span>{% endif %}
          {% if figureHebrew %}<span class="text-meta__item"><span class="text-meta__label">ייחוס:</span> {{ figureHebrew }}</span>{% endif %}
        </p>
      {% endif %}
    </header>

    <div class="text-content">
      <div class="text-controls" role="group" aria-label="גודל גופן">
        <span class="text-controls__label">גודל טקסט</span>
        <button class="text-controls__btn is-active" type="button" data-scale="md" aria-pressed="true" aria-label="טקסט רגיל">א</button>
        <button class="text-controls__btn" type="button" data-scale="sm" aria-pressed="false" aria-label="טקסט קטן">א-</button>
        <button class="text-controls__btn" type="button" data-scale="lg" aria-pressed="false" aria-label="טקסט גדול">א+</button>
        <button class="text-controls__btn" type="button" data-scale="xl" aria-pressed="false" aria-label="טקסט גדול מאוד">א++</button>
      </div>
      {% if book | usesHebrewChapterTitles and pageNumber != 0 %}
        {# Parallel layout: try to split on "### תרגום עברי" header or `<hr>` separator. #}
        {% set contentParts = content.split("<h3>תרגום עברי</h3>") %}
        {% if contentParts.length < 2 %}
          {% set contentParts = content.split("<hr>") %}
        {% endif %}
        {% if contentParts.length >= 2 %}
          <div class="parallel-controls" role="group" aria-label="תצוגת מקור">
            <button class="parallel-toggle" type="button" data-parallel-toggle="show" aria-pressed="true">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="12" y1="3" x2="12" y2="21"/></svg>
              <span>מקור + תרגום</span>
            </button>
            <button class="parallel-toggle" type="button" data-parallel-toggle="hide" aria-pressed="false">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/></svg>
              <span>תרגום בלבד</span>
            </button>
          </div>
          {# Compute verse-paired rows: both sides are first rendered exactly as in
             the classic layout (renderNoteRefs over the whole column, so the
             first-occurrence id logic for double-verse notes is preserved), then
             paired verse-by-verse. Falls back to null → classic two-column flow. #}
          {% set sourceHtml = contentParts[0] or "" %}
          {% set sourceHtml = sourceHtml | replace("<h3>מקור ארמי</h3>", "") | replace("<h3>מקור סורי</h3>", "") | replace("<h3>מקור יווני</h3>", "") | replace("<h3>מקור ערבי</h3>", "") | replace("<h3>מקור לטיני</h3>", "") | replace("<h3>מקור סלאבי</h3>", "") | replace("<h3>מקור ארמני</h3>", "") | replace("<h3>מקור געז</h3>", "") | replace("<h3>מקור עברי</h3>", "") | replace("<h4>מקור ארמי</h4>", "") | replace("<h4>מקור סורי</h4>", "") | replace("<h4>מקור יווני</h4>", "") | replace("<h4>מקור ערבי</h4>", "") | replace("<h4>מקור לטיני</h4>", "") | replace("<h4>מקור סלאבי</h4>", "") | replace("<h4>מקור ארמני</h4>", "") | replace("<h4>מקור געז</h4>", "") | replace("<h4>מקור עברי</h4>", "") %}
          {% set sourceRendered = sourceHtml | renderNoteRefs %}
          {% set translationRendered = (contentParts[1] or "") | renderNoteRefs %}
          {% set verseRows = sourceRendered | parallelVerseRows(translationRendered) %}
          <div class="parallel-layout{% if verseRows %} parallel-verse-aligned{% endif %}" data-parallel-container>
            {% set langEntry = languages[source] %}
            {% set colLang = (langEntry.iso if langEntry else source) %}
            {% if verseRows %}
              {# Verse-by-verse alignment: each verse pair gets its own grid row,
                 so verse N always sits exactly opposite verse N ("הקבלה מוחלטת"). #}
              {% for row in verseRows %}
                <div class="verse-pair">
                  <p class="verse-pair__source" lang="{{ colLang }}">{{ row.source | safe }}</p>
                  <p class="verse-pair__translation">{{ row.translation | safe }}</p>
                </div>
              {% endfor %}
            {% else %}
              <section class="column-source" data-parallel-source lang="{{ colLang }}" aria-label="מקור בשפת המקור">
                {{ sourceRendered | safe }}
              </section>
              <section class="column-translation" data-parallel-translation aria-label="תרגום עברי">
                <h2 class="column-translation__heading visually-hidden">תרגום עברי</h2>
                {{ translationRendered | safe }}
              </section>
            {% endif %}
          </div>
        {% else %}
          {{ content | renderNoteRefs | scribeMarks | safe }}
        {% endif %}
      {% else %}
        {{ content | renderNoteRefs | scribeMarks | safe }}
      {% endif %}
    </div>
{# --- תוכן הפרק המקביל מוזרק לכאן דרך JavaScript --- #}
    {% if book | hasMultipleVersions and version and version != "main" and pageNumber != 0 %}
      <aside class="version-parallel-panel" data-version-parallel-panel hidden aria-live="polite">
        <header class="version-parallel-panel__header">
          <span class="version-parallel-panel__title" data-version-parallel-title>—</span>
          <button class="version-parallel-panel__close" type="button" data-version-parallel-close aria-label="סגור תצוגה מקבילית">×</button>
        </header>
        <div class="version-parallel-panel__body" data-version-parallel-body>
          <p class="version-parallel-panel__loading" data-version-parallel-loading>טוען...</p>
        </div>
        <footer class="version-parallel-panel__footer" data-version-parallel-footer hidden>
          <div class="version-parallel-stats" data-version-parallel-stats></div>
          <div class="version-parallel-note" data-version-parallel-note></div>
        </footer>
      </aside>
    {% endif %}
  </article>

  {% if pageNumber and pageNumber != 0 and notes %}
    <div class="footnotes">
      <h2 class="footnotes__heading">הערות וביאורים</h2>
      <ul>
        {% for note in notes %}
          <li id="note-{{ loop.index }}">{{ note | renderMarkdownInline | safe }} <a href="#ref-{{ loop.index }}" class="note-backlink" aria-label="חזרה להערה {{ loop.index }}">↩</a></li>
        {% endfor %}
      </ul>
    </div>
  {% endif %}

  {# --- ניווט בין עמודים --- #}
  {% set pagesInBook = collections.all | bookPages(page.url, book) %}
  {% set chapterPages = collections.all | bookPages(page.url, book, false) | list %}
  {% set currentPageIndex = pagesInBook | findIndexByUrl(page.url) %}

  <nav class="pagination" aria-label="ניווט בין פרקים">
    <div class="pagination__position">פרק {{ currentPageIndex + 1 }} מתוך {{ pagesInBook.length }}</div>
    {% if currentPageIndex >= 0 and currentPageIndex > 0 %}
      {% set prevPage = pagesInBook[currentPageIndex - 1] %}
      <a href="{{ prevPage.url | url }}" class="prev" rel="prev">→ {{ prevPage | chapterDisplayTitle(book) }}</a>
    {% else %}
      <span aria-hidden="true"></span>
    {% endif %}

    {% if book %}
    <div class="toc-dropdown">
      <a href="{{ page.url | url }}" class="home-link" aria-haspopup="true" aria-expanded="false">תוכן העניינים</a>
      <div class="toc-dropdown-content">
        <div class="toc-dropdown-header">פרקים בטקסט</div>
        <ul>
          {% for item in chapterPages %}
            <li><a href="{{ item.url | url }}">{{ item | chapterDisplayTitle(book) }}</a></li>
          {% endfor %}
        </ul>
      </div>
    </div>
    {% endif %}

    {% if currentPageIndex >= 0 and currentPageIndex < pagesInBook.length - 1 %}
      {% set nextPage = pagesInBook[currentPageIndex + 1] %}
      <a href="{{ nextPage.url | url }}" class="next" rel="next">{{ nextPage | chapterDisplayTitle(book) }} ←</a>
    {% else %}
      <span aria-hidden="true"></span>
    {% endif %}
  </nav>

    {# --- אזור התגובות --- #}
  {% include "disqus.njk" %}

{% endblock %}
